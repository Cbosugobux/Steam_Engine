import os, json, argparse
from pathlib import Path
from datetime import datetime, timezone

import pandas as pd
from dotenv import load_dotenv

from db import connect, init_db, insert_many, was_alert_sent, mark_alert_sent
from odds_api import OddsApiClient
from parse import parse_odds_payload
from detect import detect_triggers, trigger_key_hash
from notify import send_discord_embed

BASE_DIR = Path(__file__).resolve().parent

def load_config() -> dict:
    return json.loads((BASE_DIR / "config.json").read_text())

def cmd_pull(args, cfg):
    api_key = os.getenv("ODDS_API_KEY")
    if not api_key:
        raise SystemExit("Missing ODDS_API_KEY (set it in .env)")
    client = OddsApiClient(api_key)

    allowed_books = set(cfg["books"].values())
    markets = [m.strip() for m in args.markets.split(",") if m.strip()]
    regions = args.regions

    bookmakers = ",".join(sorted(allowed_books))
    payload = client.odds(
        sport=args.sport,
        regions=regions,
        markets=",".join(markets),
        odds_format="american",
        bookmakers=bookmakers
    )

    rows = parse_odds_payload(payload, sport=args.sport, allowed_book_keys=allowed_books, markets=set(markets))

    con = connect(Path(args.db))
    init_db(con)
    n = insert_many(con, rows)
    print(f"Inserted {n} rows (duplicates ignored). Events returned: {len(payload)}")

def cmd_detect(args, cfg):
    con = connect(Path(args.db))
    init_db(con)

    markets = [m.strip() for m in args.markets.split(",") if m.strip()]
    all_tr = []
    for m in markets:
        all_tr.extend(detect_triggers(con, sport=args.sport, market=m, config=cfg))

    if not all_tr:
        print("No triggers.")
        return

    df = pd.DataFrame([t.__dict__ for t in all_tr]).sort_values(["commence_time_utc","market","outcome"])
    out = Path(args.out_csv)
    out.parent.mkdir(parents=True, exist_ok=True)
    df.to_csv(out, index=False)
    print(f"Wrote triggers to {out} ({len(df)})")
    print(df.head(20).to_string(index=False))

def cmd_run(args, cfg):
    # 1) Pull fresh snapshots
    cmd_pull(args, cfg)

    # 2) Detect triggers
    con = connect(Path(args.db))
    init_db(con)

    markets = [m.strip() for m in args.markets.split(",") if m.strip()]
    triggers = []
    for m in markets:
        triggers.extend(detect_triggers(con, sport=args.sport, market=m, config=cfg))

    if not triggers:
        print("No triggers.")
        return

    alerts = 0
    skipped_sent = 0
    failed_send = 0

    for t in triggers:
        key = trigger_key_hash(t)
        if was_alert_sent(con, key):
            skipped_sent += 1
            continue

        title = f"🏀 {t.sport.upper()} — {t.market.upper()} {t.outcome}"
        desc = f"**{t.away_team} @ {t.home_team}**\nStart: {t.commence_time_utc}"
        fields = [
            {"name": "Origin", "value": f"{t.origin_book} ({t.origin_move:+.2f})", "inline": True},
            {"name": "Best Now", "value": f"{t.current_best_book} {t.current_best_line:g}", "inline": True},
            {"name": "Notes", "value": str(t.notes)[:900], "inline": False},
        ]

        sent = send_discord_embed(title, desc, fields)
        if not sent:
            failed_send += 1
            print(f"DISCORD FAILED: {t.away_team} @ {t.home_team} | {t.market} {t.outcome}")
            continue

        # Mark sent ONLY if Discord succeeded
        mark_alert_sent(con, t.ts_utc, t.sport, str(t.event_id), t.market, t.outcome, key)

        # Store paper bet entry (CLV). Price is optional; many markets return None.
        cur = con.cursor()
        cur.execute(
            """
            INSERT OR IGNORE INTO paper_bets
            (ts_utc, sport, event_id, market, outcome, commence_time_utc,
             entry_book, entry_line, entry_price, alert_key)
            VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
            """,
            (
                t.ts_utc, t.sport, str(t.event_id), t.market, t.outcome, t.commence_time_utc,
                str(t.current_best_book), float(t.current_best_line),
                getattr(t, "current_best_price", None),
                key
            )
        )
        con.commit()

        alerts += 1
        print(f"ALERT SENT ✅  {t.away_team} @ {t.home_team} | {t.market} {t.outcome} | {t.current_best_book} {t.current_best_line:g}")

    print(f"Triggers found: {len(triggers)} | New alerts: {alerts} | Already sent: {skipped_sent} | Discord failed: {failed_send}")

def cmd_close(args, cfg):
    close_window = int(cfg.get("close_window_minutes", 15))

    con = connect(Path(args.db))
    init_db(con)
    cur = con.cursor()

    cur.execute("""
      SELECT bet_id, sport, event_id, market, outcome, commence_time_utc
      FROM paper_bets
      WHERE bet_id NOT IN (SELECT bet_id FROM paper_closes)
    """)
    bets = cur.fetchall()
    if not bets:
        print("No open paper bets.")
        return

    now = datetime.now(timezone.utc)
    closed = 0

    for bet_id, sport, event_id, market, outcome, commence_time_utc in bets:
        try:
            start = datetime.fromisoformat(str(commence_time_utc).replace("Z","+00:00"))
        except Exception:
            continue

        minutes_to = (start - now).total_seconds() / 60.0
        if minutes_to > close_window:
            continue
        if minutes_to < -120:
            continue

        cur.execute("""
          SELECT bookmaker_key, line, price, ts_utc
          FROM snapshots
          WHERE sport=? AND event_id=? AND market=? AND outcome=?
          ORDER BY (bookmaker_key='pinnacle') DESC, ts_utc DESC
          LIMIT 1
        """, (sport, str(event_id), market, outcome))
        r = cur.fetchone()
        if not r:
            continue

        close_book, close_line, close_price, ts_close = r

        cur.execute("""
          INSERT OR REPLACE INTO paper_closes
          (bet_id, ts_close_utc, close_book, close_line, close_price)
          VALUES (?, ?, ?, ?, ?)
        """, (bet_id, ts_close, close_book, float(close_line), close_price))
        con.commit()
        closed += 1

    print(f"Closed bets recorded: {closed}")

def cmd_clv(args, cfg):
    con = connect(Path(args.db))
    init_db(con)

    q = """
    SELECT
      b.bet_id,
      b.ts_utc AS ts_entry_utc,
      b.sport,
      b.event_id,
      b.market,
      b.outcome,
      b.commence_time_utc,
      b.entry_book,
      b.entry_line,
      c.ts_close_utc,
      c.close_book,
      c.close_line,
      (c.close_line - b.entry_line) AS clv
    FROM paper_bets b
    JOIN paper_closes c ON c.bet_id = b.bet_id
    ORDER BY b.ts_utc DESC
    """
    df = pd.read_sql_query(q, con)

    out = Path(args.out_csv)
    out.parent.mkdir(parents=True, exist_ok=True)
    df.to_csv(out, index=False)

    print(f"Wrote CLV report: {out} rows={len(df)}")
    if len(df):
        print(df.head(20).to_string(index=False))

def cmd_prop_pull(args, cfg):
    """
    NBA player props. Pull Pinnacle + DK/FD/BMGM/HR in ONE event-level response.
    Keep only events where Pinnacle is present for the requested prop markets.
    """
    api_key = os.getenv("ODDS_API_KEY")
    if not api_key:
        raise SystemExit("Missing ODDS_API_KEY (set it in .env)")
    client = OddsApiClient(api_key)

    if args.sport != "basketball_nba":
        raise SystemExit("prop_pull is intended for basketball_nba")

    pin = cfg["books"].get("pinnacle", "pinnacle")
    books = [
        pin,
        cfg["books"].get("draftkings", "draftkings"),
        cfg["books"].get("fanduel", "fanduel"),
        cfg["books"].get("betmgm", "betmgm"),
        cfg["books"].get("hardrock", "hardrockbet"),
    ]
    books = [b for b in books if b]
    bookmakers_csv = ",".join(books)
    allowed_books = set(books)

    prop_markets = [
        "player_rebounds",
        "player_assists",
        "player_threes",
        "player_points_rebounds_assists",
    ]
    markets_csv = ",".join(prop_markets)

    base_payload = client.odds(
        sport="basketball_nba",
        regions=args.regions,
        markets="spreads",
        odds_format="american",
        bookmakers=pin
    )
    event_ids = [str(ev.get("id")) for ev in base_payload if ev.get("id")]
    if not event_ids:
        print("No events returned for prop scan.")
        return

    con = connect(Path(args.db))
    init_db(con)

    total_inserted = 0
    events_with_pin = 0

    for eid in event_ids:
        try:
            ev_payload = client.event_odds(
                sport="basketball_nba",
                event_id=eid,
                markets=markets_csv,
                odds_format="american",
                bookmakers=bookmakers_csv
            )
        except Exception as e:
            print(f"event_odds failed for {eid}: {e}")
            continue

        bm_keys = {b.get("key") for b in (ev_payload.get("bookmakers", []) or [])}
        if pin not in bm_keys:
            continue

        pin_markets = []
        for b in ev_payload.get("bookmakers", []) or []:
            if b.get("key") == pin:
                pin_markets = [m.get("key") for m in (b.get("markets", []) or [])]
                break
        if not any(m in set(prop_markets) for m in pin_markets):
            continue

        rows = parse_odds_payload(ev_payload, sport="basketball_nba", allowed_book_keys=allowed_books, markets=set(prop_markets))
        if not rows:
            continue

        events_with_pin += 1
        total_inserted += insert_many(con, rows)

    print(f"Props: inserted {total_inserted} rows. Events scanned: {len(event_ids)}. Events w/ Pinnacle props: {events_with_pin}.")

def main():
    load_dotenv(dotenv_path=BASE_DIR / ".env")
    cfg = load_config()

    p = argparse.ArgumentParser()
    p.add_argument("--db", default="data/odds.db")
    p.add_argument("--sport", required=True, help="Odds API sport key, e.g. basketball_nba, basketball_ncaab")
    p.add_argument("--markets", default="spreads,totals")
    p.add_argument("--regions", default="us,us2,eu")
    p.add_argument("--out_csv", default="data/triggers.csv")

    sub = p.add_subparsers(dest="cmd", required=True)
    sub.add_parser("pull")
    sub.add_parser("detect")
    sub.add_parser("run")
    sub.add_parser("close")
    sub.add_parser("clv")
    sub.add_parser("prop_pull")

    args = p.parse_args()

    if args.cmd == "pull":
        cmd_pull(args, cfg)
    elif args.cmd == "detect":
        cmd_detect(args, cfg)
    elif args.cmd == "run":
        cmd_run(args, cfg)
    elif args.cmd == "close":
        cmd_close(args, cfg)
    elif args.cmd == "clv":
        cmd_clv(args, cfg)
    elif args.cmd == "prop_pull":
        cmd_prop_pull(args, cfg)

if __name__ == "__main__":
    main()

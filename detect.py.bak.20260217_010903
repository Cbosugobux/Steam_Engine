import hashlib
import sqlite3
from dataclasses import dataclass
from datetime import datetime, timedelta, timezone
from typing import Dict, List

import pandas as pd

@dataclass
class Trigger:
    sport: str
    event_id: str
    commence_time_utc: str
    home_team: str
    away_team: str
    market: str
    outcome: str
    origin_book: str
    origin_move: float
    current_best_line: float
    current_best_book: str
    ts_utc: str
    notes: str

def _utc_now() -> datetime:
    return datetime.now(timezone.utc)

def _hash_key(*parts: str) -> str:
    return hashlib.md5("|".join(parts).encode("utf-8")).hexdigest()

def trigger_key_hash(tr: Trigger) -> str:
    return _hash_key(tr.sport, tr.event_id, tr.market, tr.outcome, tr.origin_book, f"{tr.current_best_line:.3f}")

def detect_triggers(con: sqlite3.Connection, sport: str, market: str, config: Dict) -> List[Trigger]:
    lookback = float(config["lookback_hours"])
    t0 = (_utc_now() - timedelta(hours=lookback)).isoformat()

    df = pd.read_sql_query(
        """
        SELECT ts_utc, sport, event_id, commence_time_utc, home_team, away_team,
               bookmaker_key, market, outcome, line
        FROM snapshots
        WHERE sport=? AND market=? AND ts_utc>=?
        """,
        con,
        params=(sport, market, t0),
    )
    if df.empty:
        return []

    df["commence_time_utc"] = pd.to_datetime(df["commence_time_utc"], utc=True, errors="coerce")
    df = df[df["commence_time_utc"] > pd.Timestamp.utcnow()].copy()
    if df.empty:
        return []

    df["ts_utc"] = pd.to_datetime(df["ts_utc"], utc=True, errors="coerce")
    df["line"] = pd.to_numeric(df["line"], errors="coerce")
    df = df.sort_values(["event_id","outcome","bookmaker_key","ts_utc"])

    books = config["books"]

    # Sharp origin books (movement detector)
    sharp_books = set([
        books.get("pinnacle", "pinnacle"),
        books.get("betonline", "betonlineag"),
    ])

    # Bettable books (execution / best-now selection)
    bet_books = set(config.get("bet_books") or [
        books.get("draftkings", "draftkings"),
        books.get("fanduel", "fanduel"),
        books.get("betmgm", "betmgm"),
        books.get("hardrock", "hardrockbet"),
    ])
    bet_books = set([b for b in bet_books if b])

    move_thr = float(config["move_thresholds"][market])
    plateau_min = int(config["plateau_minutes"])
    snapback = float(config["snapback_points"][market])
    min_conf = int(config["min_confirmations"])

    triggers: List[Trigger] = []

    for (event_id, outcome), g in df.groupby(["event_id","outcome"], sort=False):
        series = {}
        for b, gb in g.groupby("bookmaker_key"):
            gb = gb.sort_values("ts_utc")
            tmp = gb[["ts_utc","line"]].copy()
            tmp = tmp[tmp["ts_utc"].notna() & tmp["line"].notna()]
            if tmp.empty:
                continue
            series[b] = tmp

        # must have at least one sharp book present
        if not any(b in series for b in sharp_books):
            continue

        origin = None
        best_origin_time = None

        # find earliest sharp move >= threshold
        for sb in sharp_books:
            if sb not in series:
                continue
            s = series[sb]
            if len(s) < 2:
                continue
            s2 = s.copy()
            s2["dline"] = s2["line"].diff()
            hit = s2[s2["dline"].abs() >= move_thr]
            if hit.empty:
                continue
            t_hit = hit.iloc[0]["ts_utc"]
            if best_origin_time is None or t_hit < best_origin_time:
                idx = hit.index[0]
                pos = s2.index.get_loc(idx)
                if pos == 0:
                    continue
                line_before = float(s2.iloc[pos-1]["line"])
                line_after  = float(s2.iloc[pos]["line"])
                origin = (sb, t_hit, line_before, line_after)
                best_origin_time = t_hit

        if origin is None:
            continue

        origin_book, t_hit, line_before, line_after = origin
        origin_move = float(line_after - line_before)
        direction = 1.0 if origin_move > 0 else -1.0

        # confirmations among OTHER sharp books
        confirmations = 0
        for other in sharp_books:
            if other == origin_book or other not in series:
                continue
            s = series[other]
            near = s[s["ts_utc"] <= t_hit]
            if near.empty:
                continue
            line_near = float(near.iloc[-1]["line"])
            line_latest = float(s.iloc[-1]["line"])
            if (line_latest - line_near) * direction >= (move_thr * 0.5):
                confirmations += 1

        if confirmations < min_conf:
            continue

        # plateau: origin book hasn't moved in plateau_min minutes
        s_origin = series.get(origin_book)
        last_ts = s_origin.iloc[-1]["ts_utc"]
        minutes_since = (_utc_now() - last_ts.to_pydatetime().replace(tzinfo=timezone.utc)).total_seconds() / 60.0
        if minutes_since < plateau_min:
            continue

        # snapback filter
        after = s_origin[s_origin["ts_utc"] >= t_hit]
        if len(after) >= 2:
            last_line = float(after.iloc[-1]["line"])
            max_line = float(after["line"].max())
            min_line = float(after["line"].min())
            if direction > 0 and (max_line - last_line) >= snapback:
                continue
            if direction < 0 and (last_line - min_line) >= snapback:
                continue

        # best-of-market selection for THIS outcome:
        def better(line_a, line_b):
            if market == "spreads":
                # higher is better (e.g., -4.5 beats -5.5)
                return line_a > line_b
            if outcome == "OVER":
                return line_a < line_b
            if outcome == "UNDER":
                return line_a > line_b
            return False

        # pick best line among bettable books ONLY
        best_line = None
        best_book = None
        for b in bet_books:
            if b not in series:
                continue
            s = series[b]
            line_now = float(s.iloc[-1]["line"])
            if best_line is None or better(line_now, best_line):
                best_line = line_now
                best_book = b

        # if none of the bettable books are present, skip (not actionable)
        if best_line is None or best_book is None:
            continue

        # add quick snapshot of bettable books to notes
        snapshot_parts = []
        for b in ["draftkings", "fanduel", "betmgm", "hardrockbet"]:
            if b in series:
                snapshot_parts.append(f"{b}:{float(series[b].iloc[-1]['line']):g}")
        snap_txt = " | ".join(snapshot_parts) if snapshot_parts else "—"

        meta = g.iloc[-1]
        triggers.append(Trigger(
            sport=sport,
            event_id=str(event_id),
            commence_time_utc=str(meta["commence_time_utc"]),
            home_team=str(meta["home_team"]),
            away_team=str(meta["away_team"]),
            market=market,
            outcome=str(outcome),
            origin_book=str(origin_book),
            origin_move=float(origin_move),
            current_best_line=float(best_line),
            current_best_book=str(best_book),
            ts_utc=str(meta["ts_utc"]),
            notes=f"US:{snap_txt} • conf={confirmations} • plateau={plateau_min}m • lookback={lookback}h"
        ))

    return triggers
